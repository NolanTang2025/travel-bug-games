# ========== 前端（Vite，会打进网页）==========
VITE_SUPABASE_URL=https://mwvizvnjywefiyptqizw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=你的_anon_key
VITE_SUPABASE_PROJECT_ID=mwvizvnjywefiyptqizw

# 本地预览已登录 UI（仅 dev，生产构建自动忽略）
# VITE_DEV_MOCK_AUTH=true

# ========== 登录（在 Supabase Dashboard 配置，不要写进前端 .env）==========
# 邮箱魔法链接：Auth → Providers → Email → Enable
# Google：Auth → Providers → Google → Client ID + Secret（来自 Google Cloud Console）
# Instagram：Auth → Providers → Custom → identifier 必须为 custom:instagram
#   Meta App ID/Secret 填在 Supabase Custom Provider，不要暴露到 VITE_*
#   OAuth Redirect URI（Meta 后台）：https://mwvizvnjywefiyptqizw.supabase.co/auth/v1/callback
#   Site URL / Redirect URLs（Supabase）：http://localhost:8081/** 与线上域名/**

# 扫码页 QR 指向的公网地址（本地开发也用这个，避免 QR 里是 localhost）
VITE_PUBLIC_SITE_URL=https://mnemo-games.vercel.app

# ========== 云端 Edge Functions（填好后运行 npm run secrets:sync）==========
# 本地开发用 8081；上线改为 https://mnemo.games
SITE_URL=http://localhost:8081

# AI — get key at https://platform.moonshot.cn/console/api-keys (CN) or https://platform.moonshot.ai (intl)
# After filling, run: npm run secrets:sync
moonshot_api_key=
# CN keys → api.moonshot.cn ; international keys → api.moonshot.ai
moonshot_base_url=https://api.moonshot.cn/v1
moonshot_model=moonshot-v1-8k
moonshot_vision_model=moonshot-v1-8k-vision-preview

# Slack Bot「Mnemo」— 在 api.slack.com/apps 创建应用后复制
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=https://mwvizvnjywefiyptqizw.supabase.co/functions/v1/slack-oauth
SLACK_INTERNAL_SECRET=随机一串字符

# 仅本地调试 Edge Function 时可选（一般不用填）
# SUPABASE_SERVICE_ROLE_KEY=
